<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="20dp"
        app:cardCornerRadius="90dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/black">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/buttonRecordVideo"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Записать видео"
        android:textColor="@android:color/system_error_dim_light" />

    <Button
        android:id="@+id/buttonResumeVideo"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Возобновить просмотр"
        android:textColor="@android:color/system_error_dim_light" />

    <Button
        android:id="@+id/buttonPauseVideo"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Приостановить просмотр"
        android:textColor="@android:color/system_error_dim_light" />

    <Button
        android:id="@+id/buttonStopVideo"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Остановить воспроизведение"
        android:textColor="@android:color/system_error_dim_light" />

    <Button
        android:id="@+id/buttonDeleteVideo"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Удалить видео"
        android:textColor="@android:color/system_error_dim_light" />

</LinearLayout>